{
  "name": "@notionhq/agents-client",
  "version": "1.0.0",
  "description": "TypeScript SDK for Notion Custom Agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --project tsconfig.examples.json",
    "build": "tsc",
    "format": "prettier --write src/**/*.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#dist' '#examples/cli-tool/node_modules'"
  },
  "keywords": [],
  "author": "Notion Labs, Inc.",
  "dependencies": {
    "@notionhq/client": "5.4.0",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "3.7.4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  }
}
