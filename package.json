{
  "name": "@notionhq/agents-client",
  "version": "1.0.0",
  "description": "TypeScript SDK for Notion Custom Agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [],
  "author": "Notion Labs, Inc.",
  "dependencies": {
    "@notionhq/client": "5.2.0",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
